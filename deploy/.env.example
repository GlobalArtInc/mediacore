# Copy to .env in this directory and fill in. `docker compose` reads .env from
# the directory the compose file is in, so run it from here.
#
#   cp .env.example .env
#
# The three variables that have to be filled in are shipped EMPTY on purpose:
# compose refuses to start the stack until each has a value, and says which one
# it wants. A plausible-looking example left in place would start a stack that
# signals perfectly and carries no audio, which is much harder to diagnose than
# a refusal. Nothing is generated for you either: the secret below is yours to
# make, and no build step invents one.


# --- What visitors type ---------------------------------------------------

# The domain or IP the browser is pointed at. Caddy serves this name and gets a
# certificate for it, and the front end tells the browser to open
# wss://<this>/rtc for signalling.
#
# A host name, not a url: no https://, no port unless you moved Caddy off 443,
# no trailing slash, no path. Both containers check this and refuse to start
# with the reason, because a scheme here corrupts the site address and the
# WebSocket url at once.
#
#   203.0.113.7.sslip.io   a public IP dressed as a name -> real certificate,
#                          no browser warning. Recommended when you have no
#                          domain; see "TLS without a domain" in README.md.
#   meet.example.com       your own domain -> real certificate.
#   203.0.113.7            a bare IP -> Caddy's own CA, and a full-page
#                          certificate warning for every visitor.
#
# Missing: compose refuses to start, saying which variable it wants.
MEDIACORE_PUBLIC_HOST=

# How Caddy gets the certificate for the name above.
#   you@mail.tld    Let's Encrypt, automatic, no warning. Needs the name above
#                   to resolve to this host and port 80 reachable from the
#                   internet. Works for an sslip.io name. Your address is used
#                   for expiry notices. This is the one to want.
#   internal        Caddy's own CA. The only option for a bare IP or a private
#                   LAN address. Every visitor gets a browser warning and has
#                   to click through it once, and phones often refuse the
#                   microphone afterwards anyway. Read "TLS without a domain"
#                   in README.md before settling for this.
#   /certs/cert.pem /certs/key.pem
#                   a certificate you brought yourself; mount deploy/certs (the
#                   commented volume in docker-compose.yml).
# Missing: defaults to internal, so a domain that could have had a real
# certificate gets a warning instead.
MEDIACORE_TLS=internal


# --- Where media goes -----------------------------------------------------

# THE ONE THAT BREAKS AUDIO. The address this server puts into its ICE
# candidates, which is where every browser sends its microphone. It has to be an
# IP address this host answers on from where the visitors are:
#   cloud host      its public IP (not the private one it sees on its own NIC)
#   LAN machine     its LAN address, e.g. 192.168.1.20
#   same machine    not 127.0.0.1 unless every participant is on that machine
# It is an IP, never a name: ICE candidates carry addresses, and start-sfu.sh
# refuses anything that is not one.
#
#   MEDIACORE_ADVERTISE_IP=203.0.113.7
#
# Usually the same address as MEDIACORE_PUBLIC_HOST, and necessarily different
# when that one is a domain or an sslip.io name.
# Wrong value: everyone joins, the participant list is right, the room is
# silent, and the SFU logs show no media. Missing: compose refuses to start.
MEDIACORE_ADVERTISE_IP=

# The UDP port media arrives on. Published on the host with the same number
# inside and out, and advertised as part of the candidate above. Change it and
# both sides follow. Missing: 7882.
# This port must be open in the host firewall and in any cloud security group,
# as UDP. TCP rules do nothing for it.
MEDIACORE_RTC_UDP_PORT=7882


# --- Signing tokens -------------------------------------------------------

# The API key: an identifier, not a secret. It is the `iss` of every token the
# front end mints and the name the SFU looks the secret up under.
# Missing: the SFU refuses to start.
MEDIACORE_API_KEY=mediacore

# The secret that signs those tokens. At least 32 characters; both the SFU and
# the front end refuse to start below that. Make one with:
#
#   openssl rand -hex 32
#
# Keep it to hex or letters and digits: it is written into a YAML file, and a
# quote or a backslash would corrupt it.
# Missing: compose refuses to start and tells you the command above. Wrong or
# mismatched between the two: the page loads, joining fails, and the SFU logs
# `rejecting signal connection`.
MEDIACORE_API_SECRET=


# --- Optional -------------------------------------------------------------

# The room everyone lands in, and the namespace every other room hangs off.
# `?room=standup` on the link puts that visitor in `demo.standup`; the front
# end mints tokens for this room and its namespace and for nothing else.
# Missing: demo.
MEDIACORE_FRONT_ROOM=demo

# Log verbosity of the SFU: error, warn, info, debug, trace. Missing: info.
# debug is what you want while diagnosing ICE.
MEDIACORE_LOG_LEVEL=info

# Not set here, on purpose: MEDIACORE_FRONT_WS_URL and MEDIACORE_FRONT_PORT are
# derived in docker-compose.yml from MEDIACORE_PUBLIC_HOST. Setting them in this
# file has no effect, because the compose file overrides them.
