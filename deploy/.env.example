# Copy to .env in this directory and fill in. `docker compose` reads .env from
# the directory the compose file is in, so run it from here.
#
#   cp .env.example .env
#
# The three variables that have to be filled in are shipped EMPTY on purpose:
# compose refuses to start the stack until each has a value, and says which one
# it wants. A plausible-looking example left in place would start a stack that
# signals perfectly and carries no audio, which is much harder to diagnose than
# a refusal. Nothing is generated for you either: the secret below is yours to
# make, and no build step invents one.


# --- What visitors type ---------------------------------------------------

# The domain or IP the browser is pointed at. Caddy serves this name and gets a
# certificate for it, and the front end tells the browser to open
# wss://<this>/rtc for signalling.
#
# A host name, not a url: no https://, no port unless you moved Caddy off 443,
# no trailing slash, no path. Both containers check this and refuse to start
# with the reason, because a scheme here corrupts the site address and the
# WebSocket url at once.
#
#   203.0.113.7.sslip.io   a public IP dressed as a name -> real certificate,
#                          no browser warning. Recommended when you have no
#                          domain; see "TLS without a domain" in README.md.
#   meet.example.com       your own domain -> real certificate.
#   203.0.113.7            a bare IP -> Caddy's own CA, and a full-page
#                          certificate warning for every visitor.
#
# Missing: compose refuses to start, saying which variable it wants.
MEDIACORE_PUBLIC_HOST=

# How Caddy gets the certificate for the name above.
#   you@mail.tld    Let's Encrypt, automatic, no warning. Needs the name above
#                   to resolve to this host and port 80 reachable from the
#                   internet. Works for an sslip.io name. Your address is used
#                   for expiry notices. This is the one to want.
#   internal        Caddy's own CA. The only option for a bare IP or a private
#                   LAN address. Every visitor gets a browser warning and has
#                   to click through it once, and phones often refuse the
#                   microphone afterwards anyway. Read "TLS without a domain"
#                   in README.md before settling for this.
#   /certs/cert.pem /certs/key.pem
#                   a certificate you brought yourself; mount deploy/certs (the
#                   commented volume in docker-compose.yml).
# Missing: defaults to internal, so a domain that could have had a real
# certificate gets a warning instead.
MEDIACORE_TLS=internal


# --- Where media goes -----------------------------------------------------

# THE ONE THAT BREAKS AUDIO. The address this server puts into its ICE
# candidates, which is where every browser sends its microphone. It has to be an
# IP address this host answers on from where the visitors are:
#   cloud host      its public IP (not the private one it sees on its own NIC)
#   LAN machine     its LAN address, e.g. 192.168.1.20
#   same machine    not 127.0.0.1 unless every participant is on that machine
# It is an IP, never a name: ICE candidates carry addresses, and start-sfu.sh
# refuses anything that is not one.
#
#   MEDIACORE_ADVERTISE_IP=203.0.113.7
#
# Usually the same address as MEDIACORE_PUBLIC_HOST, and necessarily different
# when that one is a domain or an sslip.io name.
# Wrong value: everyone joins, the participant list is right, the room is
# silent, and the SFU logs show no media. Missing: compose refuses to start.
MEDIACORE_ADVERTISE_IP=

# The UDP port media arrives on. Published on the host with the same number
# inside and out, and advertised as part of the candidate above. Change it and
# both sides follow. Missing: 7882.
# This port must be open in the host firewall and in any cloud security group,
# as UDP. TCP rules do nothing for it.
MEDIACORE_RTC_UDP_PORT=7882


# --- Signing tokens -------------------------------------------------------

# The API key: an identifier, not a secret. It is the `iss` of every token the
# front end mints and the name the SFU looks the secret up under.
# Missing: the SFU refuses to start.
MEDIACORE_API_KEY=mediacore

# The secret that signs those tokens. At least 32 characters; both the SFU and
# the front end refuse to start below that. Make one with:
#
#   openssl rand -hex 32
#
# Keep it to hex or letters and digits: it is written into a YAML file, and a
# quote or a backslash would corrupt it.
# Missing: compose refuses to start and tells you the command above. Wrong or
# mismatched between the two: the page loads, joining fails, and the SFU logs
# `rejecting signal connection`.
MEDIACORE_API_SECRET=


# --- Optional -------------------------------------------------------------

# The room the bare URL offers, and the namespace every other room hangs off.
# `/r/standup` on the link puts that visitor in `demo.standup`; the front end
# mints tokens for this room and its namespace and for nothing else.
# Missing: demo.
MEDIACORE_FRONT_ROOM=demo

# Log verbosity of the SFU: error, warn, info, debug, trace. Missing: info.
# debug is what you want while diagnosing ICE.
MEDIACORE_LOG_LEVEL=info


# --- Relaying media for clients that cannot reach it (optional) -----------

# THE SWITCH, and it takes two things rather than one: this secret, and
# starting a container `docker compose up` deliberately does not start.
#
#   openssl rand -hex 32                 # paste it below
#   docker compose --profile turn up -d
#
# Set, and the SFU tells every client where the relay is and mints it a
# credential as it joins, while coturn -- started with this same secret --
# checks that credential by recomputing it rather than by looking anybody up.
# Empty, as it is here, and nothing else in this section is read, no ice server
# reaches any client, and the stack is exactly what it was.
#
# The same value on both sides is the whole of it: the SFU writes it into
# rtc.ice_servers[].secret, coturn into static-auth-secret. Two different values
# authenticate nobody, and what you see is that the people who needed the relay
# -- only those, which is what makes it hard to spot -- hear nothing.
#
# Keep it to hex or letters and digits: it is pasted into two config files of
# two different kinds, and a quote, a backslash or an `&` corrupts one or the
# other. Each container refuses to start rather than paste a character that
# would ruin its own file.
#
# Changing it here takes both halves at once, and the flag is what does that:
#
#   docker compose --profile turn up -d
#
# Without `--profile turn` compose does not act on the relay at all, so the SFU
# is re-created with the new secret and coturn goes on running with the old one
# -- which is the mismatch above, arriving from the fix. `restart` is worse: it
# re-runs a container with the environment it was created with, so it does not
# pick up this file at all.
#
# Exporting MEDIACORE_TURN_* in the shell instead of writing it here works and
# overrides this file, for both containers alike -- docker-compose.yml names
# these variables on both services in the same interpolated form so that the two
# cannot resolve them from different places.
# Missing: no relay, and `--profile turn` refuses to start, saying so.
MEDIACORE_TURN_SECRET=

# What clients are told to connect to. Unlike MEDIACORE_ADVERTISE_IP this one
# may be a name -- a turn: url is resolved by the client, and a name is the only
# thing a certificate can be checked against -- but it is a host, not a url: no
# scheme, no port, no path.
# Missing: MEDIACORE_ADVERTISE_IP, which is right whenever the relay is this
# same host, and wrong the moment it is not.
MEDIACORE_TURN_HOST=

# The port coturn listens on and clients are told to use. It is opened for UDP
# and for TCP both, and both need a firewall rule: the TCP listener is what
# carries a client whose network drops UDP outright.
# Missing: 3478 on both sides.
MEDIACORE_TURN_PORT=3478

# The UDP ports coturn hands out for relaying, one per allocation and two per
# person -- a client keeps a publisher transport and a subscriber transport, and
# each is an ICE session of its own. The range below is room for fifty people
# on the relay at once. Open it in the firewall as UDP.
#
# It sits above 60999 on purpose: a default Linux hands out 32768-60999 to
# everything else on this host (`sysctl net.ipv4.ip_local_port_range`), nothing
# tells that machinery to stay off a relay range, and an overlap is coturn
# losing an allocation to a port an outbound connection took first -- on a busy
# day, not on the day this was set up. Widen it downwards and check that sysctl
# first; a host tuned for many outbound connections often has the range up
# against 65535 already.
# Missing: 61000 and 61099.
MEDIACORE_TURN_RELAY_MIN_PORT=61000
MEDIACORE_TURN_RELAY_MAX_PORT=61099

# THE ONE THAT KEEPS THIS FROM BEING AN OPEN PROXY. coturn is configured to deny
# every peer address there is and then allow this one back in, so the relay
# carries packets to the SFU and to nothing else: not to another container on
# this host, not to the cloud provider's metadata service, not to a database on
# the LAN. A relay that forwards anywhere is found by somebody sweeping for one
# within days of existing.
# Missing: MEDIACORE_ADVERTISE_IP, which is the address clients send media to
# and therefore the only peer this relay has business reaching. Left empty it
# follows that variable; set it here and it stops following, which is a thing to
# remember on the day the advertised address changes.
MEDIACORE_TURN_ALLOWED_PEER_IP=

# The address coturn puts in the candidates it hands out, which is where a
# client will send its microphone. The same mistake as MEDIACORE_ADVERTISE_IP
# and the same silence. `203.0.113.7/10.0.0.5` is the form for a host behind
# NAT: advertise the first, bind the second.
# Missing: MEDIACORE_ADVERTISE_IP.
MEDIACORE_TURN_EXTERNAL_IP=

# The realm coturn challenges an unauthenticated client with. Not a lookup key
# here -- there is no user table to look anything up in -- so it only has to be
# stable and to mean something in a log.
# Missing: MEDIACORE_PUBLIC_HOST.
MEDIACORE_TURN_REALM=

# How long a minted credential lasts, in seconds. It has to outlive the longest
# call rather than the join: coturn checks the expiry when the allocation is
# made and again on every refresh of it, so one that runs out mid-meeting takes
# the relay away mid-sentence. A stolen one is worth bandwidth through this one
# relay towards this one server and nothing else.
# Missing: 86400, a day.
MEDIACORE_TURN_TTL_SECONDS=86400

# TURN over TLS, for a network that lets nothing out but 443. These are paths
# inside the turn container, and naming them is half of it: put the files in
# deploy/certs, UNCOMMENT THE CERTS VOLUME on the turn service in
# docker-compose.yml -- it ships commented out, so without that step nothing is
# mounted at these paths -- and set MEDIACORE_TURN_HOST to a name the
# certificate covers.
#
# Both of them or neither. The relay refuses to start on half a pair or on a
# path it cannot read a file at, because coturn's own answer to either is a
# warning among the ones it prints anyway and no TLS listener; and the SFU,
# which never sees these files, offers a turns: url when both are named, so a
# listener that never opened is time every client spends for nothing.
#
# Read "TURN over TLS, and port 443" in README.md before spending an afternoon
# on it: 443 on this host belongs to Caddy, coturn cannot share the certificate
# Caddy fetched without three things going right, and turns: on 5349 cures less
# than it looks like it does.
# Missing: no TLS listener, and no turns: url offered to any client.
#MEDIACORE_TURN_TLS_CERT=/certs/cert.pem
#MEDIACORE_TURN_TLS_KEY=/certs/key.pem
#MEDIACORE_TURN_TLS_PORT=5349


# --- Recording the audio (optional) ---------------------------------------

# THE SWITCH, and it takes two things, not one. Recording needs a database --
# an upload is a row several server processes claim, and a directory of files
# cannot be a queue -- and it needs a bucket to put the audio in. Leave
# MEDIACORE_POSTGRES_URL empty, as it is here, and nothing below is read: the
# server keeps its meetings in a directory and records nothing.
#
#   MEDIACORE_POSTGRES_URL=postgres://user:password@host:5432/mediacore
#
# The database is created by you and migrated by the server on start. Set this
# and the directory of session files goes unused -- it is not read back, and it
# is not migrated across; a stand that has meetings worth keeping should be
# switched over on purpose, not by surprise.
MEDIACORE_POSTGRES_URL=

# true records every meeting. false -- the default -- still records the rooms
# that ask for it themselves, with {"sessionPolicy": {"record": true}} in the
# metadata they were created with, so a room API caller decides per room.
MEDIACORE_RECORDING_ENABLED=false

# Where the audio goes when a meeting ends: one Ogg/Opus file per person, put
# in the bucket under <prefix>/<room>/<session>/. Any S3 that speaks SigV4.
# All five are required once recording can happen at all, and the server
# refuses to start naming whichever is missing.
#
#   MEDIACORE_S3_ENDPOINT=https://storage.example.com
#   MEDIACORE_S3_BUCKET=mediacore
#
# The endpoint is a url with a scheme and no bucket in it. The region is what
# the provider says; anything is fine for the ones that ignore it.
MEDIACORE_S3_ENDPOINT=
MEDIACORE_S3_REGION=us-east-1
MEDIACORE_S3_BUCKET=
MEDIACORE_S3_ACCESS_KEY_ID=
MEDIACORE_S3_SECRET_ACCESS_KEY=

# Uploading is all mediacore does with a recording. What happens next -- a
# transcription service, an archive -- reads the bucket, or listens for the
# session event that names the object.


# --- Signing people in (optional) -----------------------------------------

# THE SWITCH. Set this to an OpenID Connect issuer and the page stops asking for
# a name: visitors are sent to that provider, come back signed in, and type only
# the room. Leave it unset -- as it is here -- and none of the four variables
# below is read, /auth/callback is a 404, and the page is exactly what it was.
#
#   MEDIACORE_FRONT_OIDC_ISSUER=https://sso.mcn.ru
#
# An https url. A realm path is fine; a query string is not.
#MEDIACORE_FRONT_OIDC_ISSUER=

# The client registered with that provider, and its secret. Both are required
# once the issuer is set, and the stack refuses to start naming whichever is
# missing rather than starting a front end that redirects nobody.
#
# The secret is read from the environment and goes exactly one place: the body
# of the server-to-server token request. It is never written into a page, a url
# or a log -- the front end's own `Debug` renders it `<redacted>`.
#MEDIACORE_FRONT_OIDC_CLIENT_ID=
#MEDIACORE_FRONT_OIDC_CLIENT_SECRET=

# What to ask the provider for. Missing: `openid profile email`, which is what
# the display name is made of. `offline_access` is deliberately not in it:
# nothing here ever spends a refresh token.
#MEDIACORE_FRONT_OIDC_SCOPES=openid profile email

# How long a session lasts, in seconds. Missing: 43200 (twelve hours). Between
# 60 and 30 days. A session running out never interrupts a call -- the join
# token was minted at join and lives its own life -- it is felt at the next page
# load, which signs the person in again.
#MEDIACORE_FRONT_SESSION_TTL=43200

# Not set here, on purpose: MEDIACORE_FRONT_PUBLIC_URL is derived in
# docker-compose.yml from MEDIACORE_PUBLIC_HOST, so the redirect uri the
# provider is handed is built from the same host name as the certificate.
# Whatever that comes out as -- https://<host>/auth/callback -- has to be
# registered with the provider, along with https://<host>/ as the post-logout
# redirect. A provider refuses a request whose redirect uri it does not
# recognise, with an error page that says nothing useful.
#
# Signing in needs real TLS. The session cookie is `__Host-` prefixed, which a
# browser refuses to accept without `Secure`, which it refuses outside a secure
# context: on plain http nothing is stored and nobody stays signed in.
# MEDIACORE_TLS=internal is fine -- a warning to click through is a secure
# context once clicked through.

# Not set here, on purpose: MEDIACORE_FRONT_WS_URL and MEDIACORE_FRONT_PORT are
# derived in docker-compose.yml from MEDIACORE_PUBLIC_HOST. Setting them in this
# file has no effect, because the compose file overrides them.
