# One origin serves everything the browser needs: the page, the token endpoint
# and the signalling WebSocket. That is deliberate. A certificate the visitor
# accepted by hand covers this host only, and a WebSocket on another host or
# port would be refused silently, with nothing in the page to show why.
#
# Media is not here. It goes to the host's UDP port, never through this proxy.
{
	admin off

	# THE LINE THAT MAKES A BARE IP WORK. A browser sends no SNI when the
	# address bar holds an IP literal, so without this Caddy has no name to
	# look a certificate up under, falls back to the container's own bridge
	# address, finds nothing for it and the handshake fails before the visitor
	# sees anything at all. Naming the site here gives the SNI-less handshake
	# the same certificate a named one would get.
	default_sni {$MEDIACORE_PUBLIC_HOST}

	# No HTTP/3: it is QUIC on 443/udp, which this compose file does not publish
	# on purpose. Advertising it would only have browsers try a port that is
	# closed and fall back. The one UDP port here is for media.
	servers {
		protocols h1 h2
	}
}

https://{$MEDIACORE_PUBLIC_HOST} {
	# you@mail.tld  -> a real certificate from Let's Encrypt, with that address
	#                  for expiry notices. Needs a name that resolves here and
	#                  port 80 reachable from the internet. With no domain of
	#                  your own, <ip>.sslip.io is a name that resolves here:
	#                  see "TLS without a domain" in README.md. This is the
	#                  only setting that gives a visitor a page with no warning.
	# internal      -> Caddy's own CA. Works for a bare IP, and every visitor
	#                  gets a full-page certificate warning to click through.
	# cert key      -> two paths to a certificate you brought yourself.
	tls {$MEDIACORE_TLS:internal}

	# Signalling. /rtc is the WebSocket, /rtc/validate is the token check, and
	# /rtc/v1 is what a recent client tries first and is answered 404 so it
	# falls back. Caddy upgrades WebSockets through reverse_proxy on its own.
	handle /rtc* {
		reverse_proxy sfu:7880
	}

	# The server API: livekit.RoomService over Twirp, for whatever creates and
	# moderates rooms. It goes to the SFU, not the front end, and it is not the
	# browser's to call -- every method needs a token carrying roomCreate,
	# roomList or roomAdmin, which is an API-key-signed token that has no
	# business in a page. It rides this origin because it is the only one
	# published.
	handle /twirp/* {
		reverse_proxy sfu:7880
	}

	# The documentation for that API, with a Try-it-out button on it.
	#
	# THE SAME UPSTREAM AS /twirp, AND THAT IS THE POINT. Every button on that
	# page posts to /twirp/livekit.RoomService/... on whatever origin served
	# the page. Route the two to different services and every button becomes a
	# cross-origin request to another port: preflighted, quite possibly on a
	# certificate this host's does not cover, and answered by nothing an
	# operator can see. The SFU serves both, so the page works here and works
	# just as well straight against the SFU's own port over an SSH tunnel.
	#
	# Delete this block to take the page off the public origin. Nothing else
	# depends on it -- the API keeps working, and an operator can still read it
	# on 127.0.0.1:7880/swagger from the host.
	handle /swagger* {
		reverse_proxy sfu:7880
	}

	# Everything else is the front end: /, /r/<room>, /app.css, /app.js, the
	# vendored client SDK, /api/config, /api/token, /healthz, and -- where
	# signing in is switched on -- /auth/callback and /auth/logout. Neither a
	# room's own url nor the sign-in routes need a rule of their own: they are
	# more paths this catch-all hands over, and the front end answers them. It
	# sets its own content security policy; nothing here rewrites response
	# headers, which matters for the Set-Cookie the sign-in relies on.
	handle {
		reverse_proxy front:8080
	}

	log {
		output stdout
		format console
	}
}
