# This file is what mediacore reads, variables and all. The server fills every
# MEDIACORE_ variable written below in from its own environment as it loads the
# file, so nothing renders a copy first and the api secret never lands on a
# filesystem: it stays an environment variable of the one process that needs it.
#
# A name nothing set is refused at startup, by name — an empty api secret would
# be a server that starts and rejects every token. A name set to an empty value
# is honoured, which is how sessions.postgres.url and the recording.s3 settings
# below read back as "no database, no recording"; deploy/start-sfu.sh empties
# five of them on purpose (the region gets a default instead) and refuses the
# four that must not be. A literal dollar is written `$$`.
#
# Empty is not an answer everywhere, though, and which it is can be read off
# this file: a variable inside quotes fills a string, and an empty string is a
# value, while a variable standing bare after the colon fills whatever YAML
# makes of the rest of the line, and nothing there is a null. recording.enabled
# and rtc.udp_port are bare and a boolean and a port have no reading of a null,
# so an empty one is the whole file refused — `enabled:` is not `false`, it is a
# boolean that is not there. start-sfu.sh gives the first a default of false and
# refuses an empty second, and a chart has to do as much in its own values.
# log_level is bare as well, and a null there reads back as an empty level: a
# server that starts and says nothing, which is why the script defaults it to
# info. MEDIACORE_ICE_SERVERS_BLOCK is the one name whose emptiness is the
# point, because it fills a block of structure rather than a value.
#
# crates/config/tests/deploy_template.rs holds every name to one column or the
# other, against this very file.

port: 7880
bind_addresses:
  - 0.0.0.0

log_level: ${MEDIACORE_LOG_LEVEL}

# The API key is the `iss` of every token, the secret signs it. The front end
# mints tokens with the same pair, from the same two variables.
keys:
  "${MEDIACORE_API_KEY}": "${MEDIACORE_API_SECRET}"

room:
  auto_create: true
  empty_timeout: 300
  departure_timeout: 20
  max_participants: 0

sessions:
  # One JSON file per meeting, read back at /api/rooms/<room>/sessions. On a
  # volume, not in the image: the container is replaced on every release and
  # anything written inside it goes with the old one. docker-compose.yml
  # mounts the `sessions` volume here.
  #
  # One process keeps meetings in the directory below. More than one process,
  # or any recording at all, needs the database instead: three processes cannot
  # share a directory, and the recording upload queue is a thing several of
  # them poll. Set MEDIACORE_POSTGRES_URL and the directory goes unused.
  directory: /var/lib/mediacore/sessions
  postgres:
    url: "${MEDIACORE_POSTGRES_URL}"

recording:
  # Recording needs MEDIACORE_POSTGRES_URL above — an upload is a row several
  # processes claim, and a directory cannot be a queue — and it needs a bucket.
  #
  # enabled=true records every meeting; false still records the rooms that ask
  # for it themselves, with {"sessionPolicy": {"record": true}} in their
  # metadata. Audio is written to the directory below while a meeting is
  # happening and uploaded whole when it ends, so that directory is a volume:
  # one inside the image would take every not-yet-uploaded recording with the
  # next release. docker-compose.yml mounts the `recordings` volume here.
  #
  # `true` or `false`, and never nothing. This is the boolean the header warns
  # about: the variable is bare, so an empty value is a null here and the server
  # refuses the file — "recording.enabled: invalid type: unit value, expected a
  # boolean". Whatever renders this environment writes `false` to turn recording
  # off, which is what start-sfu.sh does; the empty-means-off spelling belongs
  # to the five s3 names below and to the url above, and to nothing else here.
  enabled: ${MEDIACORE_RECORDING_ENABLED}
  directory: /var/lib/mediacore/recordings
  s3:
    endpoint: "${MEDIACORE_S3_ENDPOINT}"
    region: "${MEDIACORE_S3_REGION}"
    bucket: "${MEDIACORE_S3_BUCKET}"
    access_key_id: "${MEDIACORE_S3_ACCESS_KEY_ID}"
    secret_access_key: "${MEDIACORE_S3_SECRET_ACCESS_KEY}"
    path_style: true
    # A total deadline for one PUT of one segment, so it has to fit
    # recording.max_segment_mb: the default gives the default ceiling a
    # megabyte a second, and the server refuses to start on a pairing that
    # does not clear that.
    timeout_ms: 300000

events:
  # Nothing is delivered anywhere until a destination is named here: no
  # endpoint, no broker, no outbox directory and no task. What happens in a room
  # is recorded either way, under sessions.directory above.
  #
  # To post webhooks, put the endpoints in urls and name the key that signs
  # them. The shape and the signature are LiveKit's, so a receiver already
  # taking LiveKit's webhooks takes these unchanged.
  #
  #   webhooks:
  #     urls:
  #       - https://backoffice.example/mediacore/events
  #     api_key: "${MEDIACORE_API_KEY}"
  #
  # The outbox holds what has been promised and not yet taken. On a volume, not
  # in the image: an endpoint that is away over a release would otherwise lose
  # exactly the events it was away for. docker-compose.yml mounts the `events`
  # volume here.
  directory: /var/lib/mediacore/events

twirp:
  # Also answer the room API at /twirp/livekit.RoomService/<Method>, which is
  # the path LiveKit's server SDKs build in generated code and cannot be
  # pointed away from. Same handler as /twirp/mediacore.RoomService/, so it
  # costs nothing; turning it off gives those callers a bare 404 with no Twirp
  # code in it. config-sample.yaml has the rest.
  livekit_alias: true

rtc:
  # One UDP socket for all media. The compose file publishes this same port
  # number on the host, unchanged.
  udp_port: ${MEDIACORE_RTC_UDP_PORT}
  port_range_start: 0
  port_range_end: 0
  bind_address: 0.0.0.0

  # The address the server hands out in ICE candidates. Inside a container the
  # socket's own address is a private bridge address no client can route to, so
  # it is stated here and the guesses below are turned off.
  #
  # Quoted, for the one address that is a whole YAML construct unquoted: `::` on
  # its own is a mapping with a null key rather than a string, so the ipv6
  # wildcard — the value that gives a server which signals perfectly and
  # receives no media — arrived as a type error about this line instead of as
  # the refusal written for it. Quoting also turns an empty value into an empty
  # entry, which the server names as an entry that is not an address.
  advertise_addresses:
    - "${MEDIACORE_ADVERTISE_IP}"
  use_socket_address: false
  use_external_ip: false

  ice_disconnected_timeout: 20
  negotiation_timeout: 15

  # The relay clients are told to try when they cannot reach the address above.
  # Built by start-sfu.sh out of MEDIACORE_TURN_* in deploy/.env, and empty --
  # absent entirely, not an entry with nothing in it -- unless
  # MEDIACORE_TURN_SECRET is set. A client takes an ice server it is given at
  # its word: one pointing at an empty host costs it the seconds it spends
  # finding that out, which is time nobody in the room can hear anything.
  #
  # Set, it renders as:
  #
  #   ice_servers:
  #     - urls:
  #         - "turn:203.0.113.7:3478?transport=udp"
  #         - "turn:203.0.113.7:3478?transport=tcp"
  #       secret: "the same secret coturn was started with"
  #       ttl_seconds: 86400
  #
  # with a turns: url beside those two when certificate files were named. There
  # is no rendered copy of this file to read, and MEDIACORE_ICE_SERVERS_BLOCK is
  # not something to go looking for either: start-sfu.sh builds it and it lives
  # in the environment of the one process it exec'd, which `docker compose exec`
  # cannot show — exec builds a new process's environment out of the container's
  # configured one, never out of PID 1's. What start-sfu.sh decided it says at
  # startup in one line, and that line is the thing to read:
  # `docker compose logs sfu | grep start-sfu`.
  #
  # No stun: entry is rendered, deliberately. This server is ice-lite: it never
  # gathers a candidate and never uses a client's reflexive address to reach
  # anybody, so learning that address buys the client nothing. It reaches
  # advertise_addresses above directly, or it needs the relay.
${MEDIACORE_ICE_SERVERS_BLOCK}

video:
  dynacast_pause_delay_ms: 5000
  layer_upgrade_hold_ms: 2000

  # Bandwidth estimation and allocation. Off until the constrained-link bench
  # in the M5 design has been run against this deployment; config-sample.yaml
  # documents the rest of the block.
  bwe:
    enabled: false
